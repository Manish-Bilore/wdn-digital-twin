wdn:PressureSensor a owl:Class ;
    rdfs:label "pressure sensor"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue wdn:pressureHead ;
            owl:onProperty sosa:observes ],
        wdn:HydraulicSensor .

wdn:Pump a owl:Class ;
    rdfs:label "Pump"@en ;
    rdfs:subClassOf wdn:Link .

wdn:QualityCriticalNode a owl:Class ;
    rdfs:label "Water-quality critical node"@en ;
    rdfs:comment "Inferred: a dead end, where stagnation and residual decay make water-quality sensing more valuable than hydraulic sensing."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wdn:Node wdn:DeadEnd ) ] .

wdn:SmartWaterMeter a owl:Class ;
    rdfs:label "Smart water meter"@en ;
    rdfs:comment "A monitoring station that measures consumption in addition to water quality, and reports in real time."@en ;
    rdfs:subClassOf wdn:MonitoringStation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wdn:MonitoringStation [ a owl:Restriction ;
                        owl:onProperty sosa:hosts ;
                        owl:someValuesFrom wdn:FlowSensor ] ) ] .

wdn:Station_J10 a wdn:MonitoringStation ;
    rdfs:label "Monitoring station at J10"@en ;
    sosa:hosts wdn:Sensor_J10_DO,
        wdn:Sensor_J10_ORP,
        wdn:Sensor_J10_TDS,
        wdn:Sensor_J10_Temperature,
        wdn:Sensor_J10_pH ;
    wdn:addressesRisk wdn:IntrusionRisk,
        wdn:ServiceLevelRisk,
        wdn:StagnationRisk ;
    wdn:deployedAt wdn:J10 ;
    wdn:hasRationale wdn:Rationale_J10 ;
    wdn:inDMA wdn:DMA_3 ;
    wdn:monitors wdn:J10 ;
    wdn:samplingIntervalSeconds 60 .

