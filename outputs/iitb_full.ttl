wdn:NetworkElement a owl:Class ;
    rdfs:label "Network element"@en ;
    rdfs:comment "Any physical component of the water distribution network."@en ;
    rdfs:subClassOf geo:Feature .

wdn:PipeMaterial a owl:Class ;
    rdfs:label "Pipe material"@en ;
    rdfs:comment "Material class of a pipe; determines the Hazen-Williams roughness coefficient used in the hydraulic solve."@en .

wdn:PlacementCriterion a owl:Class ;
    rdfs:label "Placement criterion"@en ;
    rdfs:comment "One filter in the hierarchical overlay analysis. Reifying the criteria (rather than baking them into a boolean column) is what lets the deployment be queried by justification."@en .

wdn:DistrictMeteredArea a owl:Class ;
    rdfs:label "District metered area"@en ;
    rdfs:comment "A hydraulically delineated sub-area of the network. Here derived by k-means clustering of junction coordinates followed by Thiessen tessellation of the cluster centroids."@en ;
    rdfs:subClassOf geo:Feature ;
    skos:altLabel "DMA"@en,
        "cluster"@en,
        "zone"@en .

