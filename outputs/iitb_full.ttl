wdn:TerrainCriterion a owl:Class ;
    rdfs:label "Terrain criterion"@en ;
    rdfs:subClassOf wdn:PlacementCriterion .

wdn:TopologyCriterion a owl:Class ;
    rdfs:label "Topology criterion"@en ;
    rdfs:subClassOf wdn:PlacementCriterion .

wdn:deployedAt a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "deployed at"@en ;
    rdfs:domain wdn:MonitoringStation ;
    rdfs:range wdn:Node ;
    rdfs:subPropertyOf sosa:isFeatureOfInterestOf .

wdn:pressureHead a owl:NamedIndividual,
        sosa:ObservableProperty ;
    rdfs:label "pressure head"@en ;
    qudt:unit unit:M .

wdn:turbidity a owl:NamedIndividual,
        sosa:ObservableProperty ;
    rdfs:label "turbidity"@en ;
    qudt:unit unit:NTU ;
    wdn:permissibleMax 1 .

wdn:volumetricFlow a owl:NamedIndividual,
        sosa:ObservableProperty ;
    rdfs:label "volumetric flow"@en ;
    qudt:unit unit:L-PER-SEC .

wdn:Bend a owl:Class ;
    rdfs:label "Bend"@en ;
    rdfs:comment "A node of degree two, present only to carry geometry. Bends are excluded from sensor candidacy: they add no operational information beyond their neighbours."@en ;
    rdfs:subClassOf wdn:Node .

wdn:HydraulicSensor a owl:Class ;
    rdfs:label "Hydraulic sensor"@en ;
    rdfs:subClassOf sosa:Sensor .

wdn:Reservoir a owl:Class ;
    rdfs:label "Reservoir"@en ;
    rdfs:comment "An infinite-head boundary condition; in this network the campus head reservoir at the pump house."@en ;
    rdfs:subClassOf wdn:Node .

wdn:Tank a owl:Class ;
    rdfs:label "Storage tank"@en ;
    rdfs:subClassOf wdn:Node .

wdn:J10 a wdn:DeadEnd ;
    geo:asWKT "POINT(280320.266 2115964.571)"^^geo:wktLiteral ;
    wdn:baseDemand 0.1562 ;
    wdn:elevation 46.4 ;
    wdn:inDMA wdn:DMA_3 ;
    wdn:modelledPressure 23.84 ;
    wdn:nodeDegree 1 ;
    wdn:nodeIdentifier "J10" ;
    wdn:partOfNetwork wdn:Network_iitb ;
    wdn:satisfiesCriterion wdn:C1_JunctionOrDeadEnd,
        wdn:C2_ElevationAboveMean,
        wdn:C3_PressureTail,
        wdn:C4_DemandAboveMean .

