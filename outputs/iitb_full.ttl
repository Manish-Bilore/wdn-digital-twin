wdn:DeadEnd a owl:Class ;
    rdfs:label "Dead end"@en ;
    rdfs:comment "A terminal node of degree one. Dead ends accumulate stagnant water, lose disinfectant residual and are therefore water-quality critical out of proportion to the demand they serve."@en ;
    rdfs:subClassOf wdn:Node ;
    owl:disjointWith wdn:Bend,
        wdn:Reservoir,
        wdn:Tank .

wdn:Junction a owl:Class ;
    rdfs:label "Junction"@en ;
    rdfs:comment "A demand node where three or more links meet. Junctions are the primary candidates for instrumentation because a measurement there constrains several branches at once."@en ;
    rdfs:subClassOf wdn:Node ;
    owl:disjointWith wdn:Bend,
        wdn:DeadEnd,
        wdn:Reservoir,
        wdn:Tank .

wdn:UnknownMaterial a wdn:PipeMaterial ;
    rdfs:label "Unspecified"@en ;
    wdn:hazenWilliamsC 110 .

wdn:C1_JunctionOrDeadEnd a owl:NamedIndividual,
        wdn:TopologyCriterion ;
    rdfs:label "Junction or dead end"@en ;
    dcterms:description "Retain nodes of degree 1 or degree >= 3; discard degree-2 bends."@en ;
    wdn:filterRank 1 .

wdn:Pipe a owl:Class ;
    rdfs:label "Pipe"@en ;
    rdfs:subClassOf wdn:Link .

