wdn:Link a owl:Class ;
    rdfs:label "Link"@en ;
    rdfs:comment "A one-dimensional element connecting exactly two nodes."@en ;
    rdfs:subClassOf wdn:NetworkElement .

wdn:Node a owl:Class ;
    rdfs:label "Node"@en ;
    rdfs:comment "A zero-dimensional element: the endpoint of one or more links."@en ;
    rdfs:subClassOf wdn:NetworkElement ;
    owl:disjointWith wdn:Link .

wdn:DMA_1 a wdn:DistrictMeteredArea ;
    rdfs:label "District metered area 1"@en ;
    wdn:aggregateDemand 5.955 ;
    wdn:meanElevation 44.58 ;
    wdn:meanPressure 55.07 ;
    wdn:nodeCount 20 ;
    wdn:partOfNetwork wdn:Network_iitb .

wdn:ORPSensor a owl:Class ;
    rdfs:label "ORP sensor"@en ;
    rdfs:comment "Platinum-ring oxidation-reduction potential electrode. Used as a proxy for disinfectant residual, which is the single most diagnostic water-quality signal in a distribution network."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue wdn:oxidationReductionPotential ;
            owl:onProperty sosa:observes ],
        wdn:WaterQualitySensor ;
    skos:altLabel "redox sensor"@en .

wdn:PHSensor a owl:Class ;
    rdfs:label "pH sensor"@en ;
    rdfs:comment "Glass ion-selective electrode with BNC termination; requires temperature compensation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue wdn:pH ;
            owl:onProperty sosa:observes ],
        wdn:WaterQualitySensor .

wdn:TDSSensor a owl:Class ;
    rdfs:label "TDS sensor"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue wdn:totalDissolvedSolids ;
            owl:onProperty sosa:observes ],
        wdn:WaterQualitySensor ;
    skos:altLabel "EC sensor"@en,
        "conductivity sensor"@en,
        "dissolved salts sensor"@en .

wdn:TemperatureSensor a owl:Class ;
    rdfs:label "water temperature sensor"@en ;
    rdfs:comment "1-Wire digital thermometer. Doubles as the compensation input for the pH, TDS and DO channels, so it is a dependency of those sensors rather than an independent one."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue wdn:waterTemperature ;
            owl:onProperty sosa:observes ],
        wdn:WaterQualitySensor .

wdn:dissolvedOxygen a owl:NamedIndividual,
        sosa:ObservableProperty ;
    rdfs:label "dissolved oxygen"@en ;
    qudt:unit unit:MilliGM-PER-L ;
    wdn:permissibleMin 4 .

wdn:oxidationReductionPotential a owl:NamedIndividual,
        sosa:ObservableProperty ;
    rdfs:label "oxidation-reduction potential"@en ;
    qudt:unit unit:MilliV ;
    wdn:permissibleMax 600 ;
    wdn:permissibleMin 300 .

wdn:pH a owl:NamedIndividual,
        sosa:ObservableProperty ;
    rdfs:label "pH"@en ;
    qudt:hasQuantityKind quantitykind:PH ;
    rdfs:comment "IS 10500:2012 acceptable range for drinking water."@en ;
    wdn:permissibleMax 8.5 ;
    wdn:permissibleMin 6.5 .

wdn:totalDissolvedSolids a owl:NamedIndividual,
        sosa:ObservableProperty ;
    rdfs:label "total dissolved solids"@en ;
    qudt:unit unit:PPM ;
    rdfs:comment "IS 10500:2012 acceptable limit 500 ppm, permissible 2000 ppm in the absence of an alternate source."@en ;
    wdn:permissibleMax 500 .

wdn:waterTemperature a owl:NamedIndividual,
        sosa:ObservableProperty ;
    rdfs:label "water temperature"@en ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    qudt:unit unit:DEG_C .

wdn:CastIron a wdn:PipeMaterial ;
    rdfs:label "Cast iron (C.I.)"@en ;
    wdn:hazenWilliamsC 100 .

wdn:MonitoringStation a owl:Class ;
    rdfs:label "Monitoring station"@en ;
    rdfs:comment "The physical IoT enclosure installed at a network node, hosting one or more sensors. Modelled as a sosa:Platform so that sosa:hosts links it to its sensors."@en ;
    rdfs:subClassOf sosa:Platform .

