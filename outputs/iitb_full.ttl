wdn:Sensor_J10_DO a sosa:Sensor,
        wdn:DOSensor ;
    rdfs:label "DFRobot Gravity Analog Dissolved Oxygen"@en ;
    sosa:observes wdn:dissolvedOxygen ;
    wdn:compensatedBy wdn:Sensor_J10_Temperature ;
    wdn:hasUnit unit:MilliGM-PER-L ;
    wdn:mcuPin "A2" ;
    wdn:usesInterface wdn:AnalogInterface .

wdn:Sensor_J10_ORP a sosa:Sensor,
        wdn:ORPSensor ;
    rdfs:label "Analog ORP meter, Pt-ring electrode"@en ;
    sosa:observes wdn:oxidationReductionPotential ;
    wdn:hasUnit unit:MilliV ;
    wdn:mcuPin "A3" ;
    wdn:usesInterface wdn:AnalogInterface .

wdn:Sensor_J10_TDS a sosa:Sensor,
        wdn:TDSSensor ;
    rdfs:label "DFRobot Gravity Analog TDS"@en ;
    sosa:observes wdn:totalDissolvedSolids ;
    wdn:compensatedBy wdn:Sensor_J10_Temperature ;
    wdn:hasUnit unit:PPM ;
    wdn:mcuPin "A1" ;
    wdn:usesInterface wdn:AnalogInterface .

wdn:Sensor_J10_pH a sosa:Sensor,
        wdn:PHSensor ;
    rdfs:label "DFRobot Gravity Analog pH v2"@en ;
    sosa:observes wdn:pH ;
    wdn:compensatedBy wdn:Sensor_J10_Temperature ;
    wdn:hasUnit unit:PH ;
    wdn:mcuPin "A0" ;
    wdn:usesInterface wdn:AnalogInterface .

wdn:Sensor_J11_DO a sosa:Sensor,
        wdn:DOSensor ;
    rdfs:label "DFRobot Gravity Analog Dissolved Oxygen"@en ;
    sosa:observes wdn:dissolvedOxygen ;
    wdn:compensatedBy wdn:Sensor_J11_Temperature ;
    wdn:hasUnit unit:MilliGM-PER-L ;
    wdn:mcuPin "A2" ;
    wdn:usesInterface wdn:AnalogInterface .

wdn:Sensor_J11_ORP a sosa:Sensor,
        wdn:ORPSensor ;
    rdfs:label "Analog ORP meter, Pt-ring electrode"@en ;
