    wdn:meanPressure 31.87 ;
    wdn:nodeCount 35 ;
    wdn:partOfNetwork wdn:Network_iitb .

wdn:GalvanisedIron a wdn:PipeMaterial ;
    rdfs:label "Galvanised iron (G.I.)"@en ;
    wdn:hazenWilliamsC 120 .

