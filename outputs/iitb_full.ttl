wdn:TurbiditySensor a owl:Class ;
    rdfs:label "turbidity sensor"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue wdn:turbidity ;
            owl:onProperty sosa:observes ],
        wdn:WaterQualitySensor .

wdn:WashOut a owl:Class ;
    rdfs:label "Wash-out / scour valve"@en ;
    rdfs:subClassOf wdn:Valve .

wdn:accuracy a owl:DatatypeProperty ;
    rdfs:range xsd:string .

wdn:analogPin a owl:DatatypeProperty ;
    rdfs:label "MCU pin"@en ;
    rdfs:comment "The microcontroller pin the sensor's front-end is wired to; carried in the ontology so that a firmware map can be generated from the graph."@en ;
    rdfs:domain sosa:Sensor ;
    rdfs:range xsd:string .

wdn:baseDemand a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "base demand (L/s)"@en ;
    qudt:hasQuantityKind quantitykind:VolumeFlowRate ;
    qudt:unit unit:L-PER-SEC ;
    rdfs:comment "Average-day nodal demand, allocated by the area-based (Thiessen) method."@en ;
    rdfs:domain wdn:Node ;
    rdfs:range xsd:decimal .

wdn:compensatedBy a owl:ObjectProperty ;
    rdfs:label "compensated by"@en ;
    rdfs:comment "The subject sensor's raw reading is corrected using the object temperature sensor. Makes the pH/TDS/DO dependency on temperature explicit and machine-checkable."@en ;
    rdfs:domain sosa:Sensor ;
    rdfs:range wdn:TemperatureSensor .

wdn:connectsTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "connects to"@en ;
    rdfs:comment "Hydraulic adjacency: the two nodes are the endpoints of a common link."@en ;
    rdfs:domain wdn:Node ;
    rdfs:range wdn:Node .

wdn:diameter a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "internal diameter (mm)"@en ;
    qudt:hasQuantityKind quantitykind:Diameter ;
    qudt:unit unit:MilliM ;
    rdfs:domain wdn:Link ;
    rdfs:range xsd:decimal .

wdn:elevation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "elevation (m)"@en ;
    qudt:hasQuantityKind quantitykind:Altitude ;
    qudt:unit unit:M ;
    rdfs:domain wdn:Node ;
    rdfs:range xsd:decimal .

wdn:endNode a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "end node"@en ;
    rdfs:domain wdn:Link ;
    rdfs:range wdn:Node .

wdn:feeds a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "feeds"@en ;
    rdfs:comment "Directed, transitive supply relation: water reaching the object node has passed through the subject node. Lets a query retrieve everything downstream of a contamination point in one hop."@en ;
    rdfs:domain wdn:Node ;
    rdfs:range wdn:Node .

wdn:filterRank a owl:DatatypeProperty ;
    rdfs:label "filter rank"@en ;
    rdfs:comment "Position of the criterion in the hierarchical overlay sequence."@en ;
    rdfs:range xsd:integer .

wdn:hasMaterial a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has material"@en ;
    rdfs:domain wdn:Pipe ;
    rdfs:range wdn:PipeMaterial .

wdn:hasModel a owl:ObjectProperty ;
    rdfs:domain sosa:Sensor ;
    rdfs:range wdn:SensorModel .

wdn:hazenWilliamsC a owl:DatatypeProperty ;
    rdfs:label "Hazen-Williams C"@en ;
    rdfs:range xsd:decimal .

wdn:inDMA a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "in DMA"@en ;
    rdfs:domain wdn:NetworkElement ;
    rdfs:range wdn:DistrictMeteredArea .

wdn:length a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "length (m)"@en ;
    qudt:hasQuantityKind quantitykind:Length ;
    qudt:unit unit:M ;
    rdfs:domain wdn:Link ;
    rdfs:range xsd:decimal .

wdn:measurementRangeMax a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

wdn:measurementRangeMin a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

wdn:modelledPressure a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "modelled pressure head (m)"@en ;
    qudt:hasQuantityKind quantitykind:Pressure ;
    qudt:unit unit:M ;
    rdfs:comment "Steady-state peak-demand pressure from the EPANET solve. Distinct from an observed pressure, which is a sosa:Observation."@en ;
    rdfs:domain wdn:Node ;
    rdfs:range xsd:decimal .

wdn:monitors a owl:ObjectProperty ;
    rdfs:label "monitors"@en ;
    rdfs:domain wdn:MonitoringStation ;
    rdfs:range wdn:NetworkElement .

wdn:nodeDegree a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "node degree"@en ;
    rdfs:domain wdn:Node ;
    rdfs:range xsd:nonNegativeInteger .

wdn:permissibleMax a owl:DatatypeProperty ;
    rdfs:label "permissible maximum"@en ;
    rdfs:range xsd:decimal .

wdn:permissibleMin a owl:DatatypeProperty ;
    rdfs:label "permissible minimum"@en ;
    rdfs:range xsd:decimal .

wdn:samplingInterval a owl:DatatypeProperty ;
    rdfs:label "sampling interval"@en ;
    rdfs:domain wdn:MonitoringStation ;
    rdfs:range xsd:duration .

wdn:selectionJustification a owl:DatatypeProperty ;
    rdfs:label "selection justification"@en ;
    rdfs:domain wdn:Node ;
    rdfs:range xsd:string .

wdn:startNode a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "start node"@en ;
    rdfs:domain wdn:Link ;
    rdfs:range wdn:Node .

wdn:voronoiArea a owl:DatatypeProperty ;
    rdfs:label "Thiessen polygon area (m2)"@en ;
    qudt:unit unit:M2 ;
    rdfs:domain wdn:Node ;
    rdfs:range xsd:decimal .

wdn:C2_AboveMeanElevation a owl:NamedIndividual,
        wdn:TerrainCriterion ;
    rdfs:label "Elevation above DMA mean"@en ;
    dcterms:description "High points govern network performance: they are the first to lose pressure and the last to be refilled."@en ;
    wdn:filterRank 2 .

wdn:C3_PressureExtreme a owl:NamedIndividual,
        wdn:PressureCriterion ;
    rdfs:label "Pressure in the lower 20th or upper 80th percentile"@en ;
    dcterms:description "Low pressure risks intrusion of contaminants and consumer dissatisfaction; high pressure drives leakage and pipe bursts. Both tails are worth instrumenting; the middle is not."@en ;
    wdn:filterRank 3 .

wdn:C4_AboveMeanDemand a owl:NamedIndividual,
        wdn:DemandCriterion ;
    rdfs:label "Demand above DMA mean"@en ;
    dcterms:description "Fluctuations at high-demand nodes propagate furthest through the network."@en ;
    wdn:filterRank 4 .

wdn:DemandCriterion a owl:Class ;
    rdfs:label "Demand criterion"@en ;
    rdfs:subClassOf wdn:PlacementCriterion .

wdn:FlowSensor a owl:Class ;
    rdfs:label "flow sensor"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue wdn:volumetricFlow ;
            owl:onProperty sosa:observes ],
        wdn:HydraulicSensor .

wdn:J1 a wdn:DeadEnd ;
    geo:asWKT "POINT(280144.042 2117131.005)"^^geo:wktLiteral ;
    wdn:baseDemand 0.64225 ;
    wdn:elevation 44.22 ;
    wdn:inDMA wdn:DMA_1 ;
    wdn:modelledPressure 59.62 ;
    wdn:nodeDegree 1 ;
    wdn:nodeIdentifier "J1" ;
    wdn:partOfNetwork wdn:Network_iitb ;
    wdn:satisfiesCriterion wdn:C1_JunctionOrDeadEnd,
        wdn:C4_DemandAboveMean .

