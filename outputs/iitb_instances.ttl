wdn:Station_J27 a wdn:MonitoringStation ;
    rdfs:label "Monitoring station at J27"@en ;
    wdn:deployedAt wdn:J27 ;
    wdn:monitors wdn:J27 ;
    wdn:inDMA wdn:DMA_1 ;
    wdn:samplingIntervalSeconds "60"^^xsd:integer .
wdn:Station_J27 wdn:addressesRisk wdn:StagnationRisk .
wdn:Station_J27 wdn:addressesRisk wdn:ServiceLevelRisk .

wdn:Rationale_J27 a wdn:PlacementRationale ;
    rdfs:comment "dead end; elev 44.8 m > DMA mean 44.6; demand 0.6309 L/s > DMA mean 0.2977"@en ;
    wdn:criterionValue "44.82"^^xsd:decimal .
wdn:Station_J27 wdn:hasRationale wdn:Rationale_J27 .
wdn:Rationale_J27 wdn:satisfiesCriterion wdn:C1_JunctionOrDeadEnd .
wdn:Rationale_J27 wdn:satisfiesCriterion wdn:C2_ElevationAboveMean .
wdn:Rationale_J27 wdn:satisfiesCriterion wdn:C4_DemandAboveMean .

wdn:Sensor_J27_pH a wdn:PHSensor , sosa:Sensor ;
    rdfs:label "DFRobot Gravity Analog pH v2"@en ;
    sosa:observes wdn:pH ;
    wdn:mcuPin "A0" ;
    wdn:usesInterface wdn:AnalogInterface ;
    wdn:hasUnit unit:PH .
wdn:Station_J27 sosa:hosts wdn:Sensor_J27_pH .
wdn:Sensor_J27_pH wdn:compensatedBy wdn:Sensor_J27_Temperature .

wdn:Sensor_J27_TDS a wdn:TDSSensor , sosa:Sensor ;
    rdfs:label "DFRobot Gravity Analog TDS"@en ;
    sosa:observes wdn:totalDissolvedSolids ;
    wdn:mcuPin "A1" ;
    wdn:usesInterface wdn:AnalogInterface ;
    wdn:hasUnit unit:PPM .
wdn:Station_J27 sosa:hosts wdn:Sensor_J27_TDS .
wdn:Sensor_J27_TDS wdn:compensatedBy wdn:Sensor_J27_Temperature .

wdn:Sensor_J27_ORP a wdn:ORPSensor , sosa:Sensor ;
    rdfs:label "Analog ORP meter, Pt-ring electrode"@en ;
    sosa:observes wdn:oxidationReductionPotential ;
    wdn:mcuPin "A3" ;
    wdn:usesInterface wdn:AnalogInterface ;
    wdn:hasUnit unit:MilliV .
wdn:Station_J27 sosa:hosts wdn:Sensor_J27_ORP .

wdn:Sensor_J27_DO a wdn:DOSensor , sosa:Sensor ;
    rdfs:label "DFRobot Gravity Analog Dissolved Oxygen"@en ;
    sosa:observes wdn:dissolvedOxygen ;
    wdn:mcuPin "A2" ;
    wdn:usesInterface wdn:AnalogInterface ;
    wdn:hasUnit unit:MilliGM-PER-L .
wdn:Station_J27 sosa:hosts wdn:Sensor_J27_DO .
wdn:Sensor_J27_DO wdn:compensatedBy wdn:Sensor_J27_Temperature .

wdn:Sensor_J27_Temperature a wdn:TemperatureSensor , sosa:Sensor ;
