    sosa:observes wdn:waterTemperature ;
    wdn:mcuPin "D2" ;
    wdn:usesInterface wdn:OneWireInterface ;
    wdn:hasUnit unit:DEG_C .
wdn:Station_J27 sosa:hosts wdn:Sensor_J27_Temperature .

