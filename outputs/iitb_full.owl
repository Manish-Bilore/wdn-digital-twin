  <rdf:Description rdf:about="https://w3id.org/iitb/wdn#Junction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iitb/wdn#Node"/>
    <rdfs:label xml:lang="en">Junction</rdfs:label>
    <rdfs:comment xml:lang="en">A demand node where three or more links meet. Junctions are the primary candidates for instrumentation because a measurement there constrains several branches at once.</rdfs:comment>
