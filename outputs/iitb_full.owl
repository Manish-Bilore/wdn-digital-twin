    <owl:disjointWith rdf:resource="https://w3id.org/iitb/wdn#Bend"/>
    <owl:disjointWith rdf:resource="https://w3id.org/iitb/wdn#Tank"/>
    <owl:disjointWith rdf:resource="https://w3id.org/iitb/wdn#Reservoir"/>
  </rdf:Description>
