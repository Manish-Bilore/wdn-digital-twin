    <wdn:satisfiesCriterion rdf:resource="https://w3id.org/iitb/wdn#C2_ElevationAboveMean"/>
    <wdn:satisfiesCriterion rdf:resource="https://w3id.org/iitb/wdn#C3_PressureTail"/>
    <wdn:satisfiesCriterion rdf:resource="https://w3id.org/iitb/wdn#C4_DemandAboveMean"/>
  </rdf:Description>
